# 3) Compute returns for 30D, 3M, YTD and vs SPX

last_date = max([s.index.max() for s in adj_close.values() if not s.empty])

periods = {
    "30d": last_date - timedelta(days=30),
    "3m": last_date - timedelta(days=90),
    "ytd": datetime(last_date.year, 1, 1)
}

# Build combined DataFrame of closes aligned
all_adj_df = pd.DataFrame({t: s for t, s in adj_close.items() if not s.empty})
all_adj_df = all_adj_df.loc[all_adj_df.index <= last_date]

spx_series = all_adj_df.get(SPX_TICKER)

returns = {}
for label, start_ts in periods.items():
    start_ts = all_adj_df.index[all_adj_df.index.get_loc(start_ts, method='nearest')]
    window = all_adj_df.loc[start_ts:last_date]
    r = window.apply(lambda col: (col.iloc[-1] / col.iloc[0]) - 1.0, axis=0)
    returns[label] = r

returns_df = pd.DataFrame(returns)

# vs SPX deltas
for label in periods.keys():
    if SPX_TICKER in returns_df.index:
        returns_df[f"{label}_vs_spx"] = returns_df[label] - returns_df.loc[SPX_TICKER, label]
    else:
        returns_df[f"{label}_vs_spx"] = np.nan

