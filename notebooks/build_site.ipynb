# Utility: nearest trading day close

def last_trading_day(ts: datetime) -> datetime:
    d = ts
    # yfinance handles weekends by auto-adjusting, but we keep this for clarity
    while d.weekday() >= 5:  # 5=Sat, 6=Sun
        d -= timedelta(days=1)
    return d


def pct_change(series: pd.Series) -> float:
    if series is None or len(series) < 2:
        return np.nan
    try:
        return (series.iloc[-1] / series.iloc[0]) - 1.0
    except Exception:
        return np.nan


def human_billions(x: float) -> str:
    if pd.isna(x):
        return "—"
    if abs(x) >= 1e12:
        return f"${x/1e12:.1f}T"
    if abs(x) >= 1e9:
        return f"${x/1e9:.1f}B"
    if abs(x) >= 1e6:
        return f"${x/1e6:.1f}M"
    return f"${x:,.0f}"


def human_ratio(x: float) -> str:
    if pd.isna(x) or x == 0:
        return "—"
    return f"{x:.1f}×"


def human_pct(x: float) -> str:
    if pd.isna(x):
        return "—"
    return f"{x*100:.1f}%"

