def latest_value(series: pd.Series):
    return series.iloc[-1] if series is not None and len(series) else np.nan

def prev_value(series: pd.Series):
    return series.iloc[-2] if series is not None and len(series) >= 2 else np.nan

rows = []
for t in TICKERS:
    cser = close.get(t)
    vser = volume.get(t)
    if cser is None or vser is None or len(cser) == 0 or len(vser) == 0:
        continue
    cv = latest_value(cser)
    vv = latest_value(vser)
    pv = prev_value(cser)
    if pd.isna(cv) or pd.isna(vv):
        continue
    dollar_vol = float(cv) * float(vv)
    chg = (cv / pv - 1.0) if (not pd.isna(pv) and pv != 0) else np.nan
    rows.append({
        'ticker': t,
        'dollar_vol_val': dollar_vol,
        'dollar_volume': human_billions(dollar_vol),
        'change_pct': human_pct(chg),
        'change_class': 'pos' if pd.notna(chg) and chg > 0 else ('neg' if pd.notna(chg) and chg < 0 else ''),
    })

