from datetime import datetime, timedelta

import numpy as np
import pandas as pd
import yfinance as yf
import requests
from bs4 import BeautifulSoup
from jinja2 import Template

OUTPUT_DIR = "/workspace/dist"
TEMPLATES_DIR = "/workspace/site/templates"
STATIC_DIR = "/workspace/site/static"

os.makedirs(OUTPUT_DIR, exist_ok=True)

POLYGON_API_KEY = os.getenv("POLYGON_API_KEY", None)
SPX_TICKER = "^GSPC"


def last_trading_day(ts: datetime) -> datetime:
    d = ts
    while d.weekday() >= 5:
        d -= timedelta(days=1)
    return d


def human_billions(x: float) -> str:
    if pd.isna(x):
        return "—"
    if abs(x) >= 1e12:
        return f"${x/1e12:.1f}T"
    if abs(x) >= 1e9:
        return f"${x/1e9:.1f}B"
    if abs(x) >= 1e6:
        return f"${x/1e6:.1f}M"
    return f"${x:,.0f}"


def human_ratio(x: float) -> str:
    if pd.isna(x) or x == 0:
        return "—"
    return f"{x:.1f}×"


def human_pct(x: float) -> str:
    if pd.isna(x):
        return "—"
    return f"{x*100:.1f}%"

print("Environment ready.")

