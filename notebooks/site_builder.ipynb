rows = []
window_days = 30
for t in TICKERS:
    vser = volume.get(t)
    if vser is None or len(vser) < window_days + 1:
        continue
    recent = vser.iloc[-1]
    avg = vser.iloc[-(window_days+1):-1].mean()
    ratio = (recent / avg) if avg and avg > 0 else np.nan
    rows.append({
        'ticker': t,
        'volume': human_billions(recent),
